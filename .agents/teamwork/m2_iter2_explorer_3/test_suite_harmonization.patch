+    const list = this.listeners.get(event) || [];
+    this.listeners.set(event, list.filter((f) => f !== fn));
+  }
+  dispatchEvent(event: any): boolean {
+    const list = this.listeners.get(event?.type) || [];
+    for (const fn of list) {
